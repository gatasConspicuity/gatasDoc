---
import { docs, hrefFor, sections } from '../data/navigation';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
---

<aside id="site-sidebar" class="sidebar">
  <div class="sidebar-inner">
    <p class="sidebar-label">Documentation</p>
    <nav aria-label="Documentation navigation">
      {sections.map((section) => (
        <section class="nav-group">
          <h2>{section}</h2>
          <ul>
            {docs
              .filter((page) => page.section === section)
              .map((page) => (
                <li>
                  <a
                    href={hrefFor(page.slug)}
                    aria-current={page.slug === currentSlug ? 'page' : undefined}
                  >
                    <span>{page.title}</span>
                    {page.slug === currentSlug && <span aria-hidden="true">›</span>}
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </nav>

    <div class="sidebar-footer">
      <span class="status-dot" aria-hidden="true"></span>
      <span>Open-source avionics</span>
    </div>
  </div>
</aside>
<button class="sidebar-scrim" type="button" aria-label="Close documentation menu"></button>
